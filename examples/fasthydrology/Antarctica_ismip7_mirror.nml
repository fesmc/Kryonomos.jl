! Mirror namelist for coupled-hydrology runs on ANT-32KM, built from the ISMIP7 Antarctica
! spin-up j32_ours in yelmox (output/ismip7_ant/j32_ours, yelmo d75200e, Javi s parameters, basin tf_corr): its yelmo groups are
! copied verbatim so a run restarted from its 30 kyr restart keeps the same physics, including
! the optimised friction (ytill.method = -1 keeps the restart's cb_ref). &phys holds the yelmo
! "Earth" constants (input/yelmo_phys_const.nml). Coupled runs override ytherm (enth + capacity)
! and yhyd.bkt_N_closure in Julia (mirror_nml_ismip7). Keys dev yelmo dropped since d75200e were
! removed (cfl_diff_max, pc_corr_vel, dHdt_dyn_lim, f_ice_method, margin2nd, margin_flt_subgrid,
! surf_gl_method, cb_sia, ssa_beta_max, T_frz, k24_long_coupling_water, cp_rock) or mapped
! (tau_ice -> tau_ice_flt/tau_ice_grnd, scale_T = 0 -> slide_T = .false.); keys new in dev take
! the yelmo_defaults.nml values.
&phys
    sec_year             = 31556926.0
    g                    = 9.81
    T0                   = 273.15
    rho_ice              = 910.0
    rho_w                = 1000.0
    rho_sw               = 1028.0
    rho_a                = 3300.0
    rho_rock             = 2000.0
    L_ice                = 333500.0
    T_pmp_beta           = 9.8e-8
/

&yelmo
 domain          = 'Antarctica'
 grid_name       = 'ANT-32KM' 
 grid_path       = 'ice_data/{domain}/{grid_name}/{grid_name}_REGIONS.nc'
 phys_const      = 'Earth'    
 experiment      = 'None'     
 nml_ytopo       = 'ytopo'    
 nml_ycalv       = 'ycalv'    
 nml_ydyn        = 'ydyn'     
 nml_ytill       = 'ytill'    
 nml_yhyd        = 'yhyd'     
 nml_ymat        = 'ymat'     
 nml_ytherm      = 'ytherm'   
 nml_masks       = 'yelmo_masks'
 nml_init_topo   = 'yelmo_init_topo'
 nml_data        = 'yelmo_data'
 restart         = 'none'     
 restart_z_bed   = .true.     
 restart_H_ice   = .true.     
 restart_relax   = 0.0        
 log_timestep    = .false.    
 disable_kill    = .false.    
 zeta_scale      = 'exp'      
 zeta_exp        = 2.0        
 nz_aa           = 11         
 dt_method       = 2          
 dt_min          = 0.1        
 cfl_max         = 0.5        
 pc_method       = 'AB-SAM'   
 pc_controller   = 'PI42'     
 pc_use_H_pred   = .true.     
 pc_filter_vel   = .true.     
 pc_n_redo       = 5          
 pc_tol          = 5.0        
 pc_eps          = 1.0        
/

&ytopo
 solver          = 'impl-lis' 
 grad_lim        = 0.05       
 grad_lim_zb     = 0.05       
 use_bmb         = .true.     
 topo_fixed      = .false.    
 topo_rel        = 0          
 topo_rel_tau    = 10.0       
 topo_rel_field  = 'H_ref'    
 bmb_gl_method   = 'pmp'      
 gl_sep          = 2          
 gz_nx           = 15         
 dist_grz        = 200.0      
 gz_Hg0          = 0.0        
 gz_Hg1          = 0.0        
 dmb_method      = 0          
 dmb_alpha_max   = 60.0       
 dmb_tau         = 100.0      
 dmb_sigma_ref   = 300.0      
 dmb_m_d         = 3.0        
 dmb_m_r         = 1.0        
 fmb_method      = 0          
 fmb_scale       = 1.0        
/

&ycalv
 use_lsf         = .true.     
 lsf_method      = 'snap'     
 dt_lsf          = -1         
 lsf_redist_n_iter = 5        
 calv_flt_method = 'equil'    
 calv_grnd_method = 'equil'   
 H_min_grnd      = 5.0        
 H_min_flt       = 5.0        
 sd_min          = 100.0      
 sd_max          = 500.0      
 calv_grnd_max   = 0.0        
 calv_tau        = 1.0        
 calv_thin       = 30.0       
 k2              = 3200000000.0
 w2              = 0.0        
 kt_ref          = 0.0025     
 kt_deep         = 0.1        
 Hc_ref_flt      = 200.0      
 Hc_ref_grnd     = 100.0      
 Hc_ref_thin     = 50.0       
 Hc_deep         = 500.0      
 zb_deep_0       = -1000.0    
 zb_deep_1       = -1500.0    
 zb_sigma        = 0.0        
 tau_ice_flt     = 125000.0     ! was tau_ice = 125000 (one value for both)
 tau_ice_grnd    = 125000.0
/

&ydyn
 solver          = 'diva'     
 uz_method       = 3          
 visc_method     = 1          
 visc_const      = 10000000.0 
 beta_method     = 3          
 beta_const      = 1000.0     
 beta_q          = 0.2        
 beta_u0         = 100.0      
 beta_gl_scale   = 0          
 beta_gl_stag    = 3          
 beta_gl_f       = 1.0        
 taud_gl_method  = 0          
 H_grnd_lim      = 500.0      
 beta_min        = 20.0       
 eps_0           = 1e-06      
 ssa_solver      = 'energy'   
 ssa_lis_opt_residual = '-i minres -p jacobi -maxiter 100 -tol 1.0e-2 -initx_zeros false'
 ssa_lis_opt_energy = '-i cg -p jacobi -maxiter 200 -tol 1.0e-4 -initx_zeros false'
 ssa_lat_bc      = 'all'      
 ssa_vel_max     = 5000.0     
 ssa_iter_max    = 4          
 ssa_iter_rel    = 0.7        
 ssa_iter_conv   = 0.01       
 taud_lim        = 200000.0   
 neff_nxi        = 0          
 slide_T         = .false.    ! was scale_T = 0: no temperature scaling of sliding, as the friction was optimised
/

&ytill
 method          = -1         
 scale_zb        = 0          
 scale_sed       = 0          
 is_angle        = .false.    
 n_sd            = 10         
 f_sed           = 1.0        
 sed_min         = 5.0        
 sed_max         = 15.0       
 z0              = -250.0     
 z1              = 250.0      
 cf_min          = 0.0001     
 cf_ref          = 1          
/

&yhyd
 method_til      = 1          
 method_transport = 0         
 W_til_max       = 2.0        
 mask_bc         = 2          
 W_til_bc        = 0.0        
 bkt_N_closure   = 2          
 bkt_till_rate   = 0.001      
 bkt_floating_mode = 1        
 const_N         = 10000000.0 
 marine_p        = 1.0        
 marine_rho_sw   = 1028.0     
 till_N0         = 1000.0     
 till_delta      = 0.8        
 till_e0         = 0.69       
 till_Cc         = 0.12       
 two_value_delta = 0.02       
 k24_substrate_type = 2       
 k24_manning_exponent = 3.0   
 k24_latent_heat_water = 335000.0
 k24_bed_thickness = 0.1      
 k24_manning_coefficient_exponent = 1.25
 k24_bed_friction_exponent = 1.5
 k24_friction_factor = 0.1    
 k24_till_factor = 1.1        
 k24_critical_discharge = 1.0 
 k24_initial_cavity_height = 0.1
 k24_coupling_length = 10000.0
 k24_min_pressure_fraction = 0.02
 k24_eta_w       = 0.0018     
 k24_W_min       = 1e-08      
 k24_W_max       = 0.015      
/

&ymat
 flow_law        = 'glen'     
 rf_method       = 1          
 rf_const        = 1e-18      
 rf_use_eismint2 = .false.    
 rf_with_water   = .false.    
 n_glen          = 3.0        
 visc_min        = 1000.0     
 de_max          = 0.5        
 enh_method      = 'shear3D'  
 enh_shear       = 1.0        
 enh_stream      = 1.0        
 enh_shlf        = 0.5        
 enh_umin        = 50.0       
 enh_umax        = 500.0      
 tracer_method   = 'expl'     
 tracer_impl_kappa = 1.5      
/

&ytherm
 method          = 'temp'     
 qb_method       = 2          
 dt_method       = 'FE'       
 solver_advec    = 'impl-upwind'
 gamma           = 1.0        
 use_strain_sia  = .false.    
 use_const_cp    = .false.    
 const_cp        = 2009.0     
 use_const_kt    = .false.    
 const_kt        = 66200000.0 
 enth_cr         = 0.001      
 omega_max       = 0.01       
 rock_method     = 'active'   
 nzr_aa          = 5          
 zeta_scale_rock = 'exp-inv'  
 zeta_exp_rock   = 2.0        
 H_rock          = 2000.0     
 kt_rock         = 63000000.0 
/

&yelmo_masks
 basins_load     = .true.     
 basins_path     = 'ice_data/ISMIP7/{domain}/{grid_name}/obs/{grid_name}_ObsISMIP7-v1.1.nc'
 basins_nms      = 'mouginot_basins' 'mouginot_basins'
 regions_load    = .true.     
 regions_path    = 'ice_data/{domain}/{grid_name}/{grid_name}_REGIONS.nc'
 regions_nms     = 'mask' 'None'
/

&yelmo_init_topo
 init_topo_load  = .true.     
 init_topo_path  = 'ice_data/ISMIP7/{domain}/{grid_name}/obs/{grid_name}_ObsISMIP7-v1.1.nc'
 init_topo_names = 'thickness_bedmap3' 'bed_bedmap3' 'bed_bedmap3' 'surface_bedmap3'
 init_topo_state = 0          
 z_bed_f_sd      = 0.0        
 smooth_H_ice    = 0.0        
 smooth_z_bed    = 0.0        
/

&yelmo_data
 pd_topo_load    = .true.     
 pd_topo_path    = 'ice_data/ISMIP7/{domain}/{grid_name}/obs/{grid_name}_ObsISMIP7-v1.1.nc'
 pd_topo_names   = 'thickness_bedmap3' 'bed_bedmap3' 'bed_bedmap3' 'surface_bedmap3' 'mask_bedmap3'
 pd_tsrf_load    = .true.     
 pd_tsrf_path    = 'ice_data/{domain}/{grid_name}/RACMO2.3/{grid_name}_RACMO23-VW23.nc'
 pd_tsrf_name    = 'T_srf'    
 pd_tsrf_monthly = .true.     
 pd_smb_load     = .true.     
 pd_smb_path     = 'ice_data/{domain}/{grid_name}/RACMO2.3/{grid_name}_RACMO23-VW23.nc'
 pd_smb_name     = 'smb'      
 pd_smb_monthly  = .true.     
 pd_vel_load     = .true.     
 pd_vel_path     = 'ice_data/ISMIP7/{domain}/{grid_name}/obs/{grid_name}_ObsISMIP7-v1.1.nc'
 pd_vel_names    = 'vx_mosaic' 'vy_mosaic'
 pd_age_load     = .false.    
 pd_age_path     = 'input/{domain}/{grid_name}/{grid_name}_STRAT-M15.nc'
 pd_age_names    = 'age_iso' 'depth_iso'
/
